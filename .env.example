# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# SERVIDOR
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
PORT=3000
NODE_ENV=development
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# BASE DE DATOS
# DB_TYPE controla que driver usar: mysql | postgres
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=watto_db
DB_USER=root
DB_PASSWORD=tu_password_segura_aqui
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# JWT — AUTENTICACION
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# Genera una clave secreta aleatoria: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_jwt_secret_muy_largo_y_aleatorio_aqui
JWT_EXPIRES_IN=24h
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# PROVIDER AI
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
AI_PROVIDER=openai
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# OPENAI
# Obtén tu API key en: https://platform.openai.com/api-keys
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
OPENAI_API_KEY=sk-tu-api-key-de-openai-aqui
OPENAI_MODEL=gpt-4o-mini
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# GOOGLE GEMINI AI
# Obtén tu API key en: https://aistudio.google.com/app/apikey
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy-tu-api-key-de-gemini-aqui
AI_MODEL=gemini-1.5-flash
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# PARAMETROS CONSUMO AI
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.3
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# AGENTE AUTÓNOMO
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# Modo: db | api | both
AGENT_MODE=db
# Nombre e identidad del agente
AGENT_NAME=Watto
AGENT_CONTEXT=Sistema de gestión de datos empresariales
# Tablas a excluir del esquema (separadas por coma)
AGENT_DB_EXCLUDE_TABLES=migrations,sessions,usuarios
# NOTA: excluimos la tabla usuarios del esquema para que
# el agente no pueda ver ni consultar datos de autenticación
# Máximo de filas por consulta
AGENT_DB_MAX_ROWS=100
# Configuración API externa (solo si AGENT_MODE=api o both)
AGENT_API_OPENAPI_URL=
AGENT_API_BASE_URL=
AGENT_API_AUTH_TOKEN=
AGENT_API_AUTH_TYPE=bearer
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# FRONTEND (Vite)
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# Solo necesario para builds de producción
VITE_API_URL=https://tu-dominio.com
VITE_AGENT_NAME=Watto
VITE_APP_VERSION=0.1.0
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
